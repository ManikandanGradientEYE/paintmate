# Prisma CLI reads DATABASE_URL / DIRECT_URL from .env (not .env.local).
# Get both from your Neon project dashboard -> Connection Details:
#   DATABASE_URL = the "Pooled connection" string (host ends in -pooler)
#   DIRECT_URL   = the "Direct connection" string (used only for migrations)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Next.js reads these from .env.local — copy this file to .env.local and fill in.
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_SESSION_SECRET="a-long-random-string-used-to-sign-the-admin-session-cookie"

# Only while moving to Hostinger MySQL (scripts/neon-to-mysql.ts). Get the host from
# hPanel -> Databases -> Remote MySQL; URL-encode special characters in the password.
MYSQL_DATABASE_URL="mysql://u123456789_user:password@srv123.hstgr.io:3306/u123456789_paintmate"
