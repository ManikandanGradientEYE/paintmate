# Prisma CLI reads DATABASE_URL from .env (not .env.local). Hostinger MySQL — get the
# host from hPanel -> Databases -> Remote MySQL (your IP must be allowed there to connect
# from your PC); URL-encode special characters in the password (@ -> %40).
DATABASE_URL="mysql://u123456789_user:password@srv123.hstgr.io:3306/u123456789_paintmate"

# Next.js reads these from .env.local — copy this file to .env.local and fill in.
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_SESSION_SECRET="a-long-random-string-used-to-sign-the-admin-session-cookie"

# Only until Hostinger is live: the old Neon database, read by scripts/neon-to-mysql.ts.
NEON_DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
